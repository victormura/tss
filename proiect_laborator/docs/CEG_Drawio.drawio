<mxfile host="app.diagrams.net">
  <diagram id="CEG_ParkingGate" name="Graful Cauza-Efect Smart Parking Gate">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLU SI HEADER -->
        <mxCell id="title" value="GRAFUL CAUZĂ-EFECT — SMART PARKING GATE (TSS 2026)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#203752;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="700" height="30" as="geometry" />
        </mxCell>

        <!-- CAUZE (Stânga) -->
        <mxCell id="grp_causes" value="CAUZE (CONDIȚII DE INTRARE)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#EBF7F5;strokeColor=#138A83;fontColor=#138A83;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="240" height="680" as="geometry" />
        </mxCell>

        <mxCell id="C1" value="C1: tier == VIP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#138A83;fontColor=#ffffff;strokeColor=#0d5c57;fontStyle=1;" vertex="1" parent="grp_causes">
          <mxGeometry x="20" y="40" width="200" height="40" as="geometry" />
        </mxCell>

        <mxCell id="C2" value="C2: tier == CONTRACTOR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#138A83;fontColor=#ffffff;strokeColor=#0d5c57;fontStyle=1;" vertex="1" parent="grp_causes">
          <mxGeometry x="20" y="110" width="200" height="40" as="geometry" />
        </mxCell>

        <mxCell id="C3" value="C3: ore de vârf (08–17)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#138A83;fontColor=#ffffff;strokeColor=#0d5c57;fontStyle=1;" vertex="1" parent="grp_causes">
          <mxGeometry x="20" y="190" width="200" height="40" as="geometry" />
        </mxCell>

        <mxCell id="C4" value="C4: vehicul electric (is_ev)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#138A83;fontColor=#ffffff;strokeColor=#0d5c57;fontStyle=1;" vertex="1" parent="grp_causes">
          <mxGeometry x="20" y="270" width="200" height="40" as="geometry" />
        </mxCell>

        <mxCell id="C5" value="C5: stație EV liberă (has_spots)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#138A83;fontColor=#ffffff;strokeColor=#0d5c57;fontStyle=1;" vertex="1" parent="grp_causes">
          <mxGeometry x="20" y="340" width="200" height="40" as="geometry" />
        </mxCell>

        <mxCell id="C6" value="C6: ocupate &lt; cotă (within_quota)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#138A83;fontColor=#ffffff;strokeColor=#0d5c57;fontStyle=1;" vertex="1" parent="grp_causes">
          <mxGeometry x="20" y="420" width="200" height="40" as="geometry" />
        </mxCell>

        <mxCell id="C7" value="C7: overflow permis (allows_overflow)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#138A83;fontColor=#ffffff;strokeColor=#0d5c57;fontStyle=1;" vertex="1" parent="grp_causes">
          <mxGeometry x="20" y="500" width="200" height="40" as="geometry" />
        </mxCell>

        <mxCell id="C8" value="C8: depășire &lt; 5 (overflow &lt; 5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#138A83;fontColor=#ffffff;strokeColor=#0d5c57;fontStyle=1;" vertex="1" parent="grp_causes">
          <mxGeometry x="20" y="580" width="200" height="40" as="geometry" />
        </mxCell>

        <!-- Constrângere E (Exclusive) între C1 și C2 -->
        <mxCell id="E_C1_C2" value="E" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#203752;fontColor=#ffffff;strokeColor=#138A83;fontStyle=1;fontSize=11;" vertex="1" parent="grp_causes">
          <mxGeometry x="105" y="82" width="25" height="25" as="geometry" />
        </mxCell>
        <mxCell id="edge_E1" edge="1" source="C1" target="E_C1_C2" style="dashed=1;endArrow=none;strokeColor=#203752;strokeWidth=1.5;" parent="grp_causes" />
        <mxCell id="edge_E2" edge="1" source="E_C1_C2" target="C2" style="dashed=1;endArrow=none;strokeColor=#203752;strokeWidth=1.5;" parent="grp_causes" />

        <!-- NODURI LOGICE INTERMEDIARE (Centru) -->
        <!-- NOT pe C3 -->
        <mxCell id="OP_NOT_C3" value="~" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#203752;strokeWidth=2;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="380" y="275" width="35" height="35" as="geometry" />
        </mxCell>

        <!-- AND pentru Contractor în afara orelor (C2 AND NOT_C3) -->
        <mxCell id="OP_AND_C2" value="^" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#203752;strokeWidth=2;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="540" y="200" width="35" height="35" as="geometry" />
        </mxCell>

        <!-- AND pentru vehicul EV (C4 AND C5) -->
        <mxCell id="OP_AND_EV_BASE" value="^" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#203752;strokeWidth=2;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="450" y="385" width="35" height="35" as="geometry" />
        </mxCell>

        <!-- OR pentru EV (NOT_C3 OR C6) -->
        <mxCell id="OP_OR_EV_COND" value="v" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#203752;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="540" y="440" width="35" height="35" as="geometry" />
        </mxCell>

        <!-- AND FINAL PENTRU E3 (EV) -->
        <mxCell id="OP_AND_EV_FINAL" value="^" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#203752;strokeWidth=2;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="680" y="410" width="35" height="35" as="geometry" />
        </mxCell>

        <!-- OR pentru Overflow (NOT_C3 OR C8) -->
        <mxCell id="OP_OR_OVF_COND" value="v" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#203752;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="540" y="610" width="35" height="35" as="geometry" />
        </mxCell>

        <!-- AND FINAL PENTRU E5 (Overflow) -->
        <mxCell id="OP_AND_OVF_FINAL" value="^" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#203752;strokeWidth=2;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="680" y="590" width="35" height="35" as="geometry" />
        </mxCell>

        <!-- EFECTE (Dreapta) -->
        <mxCell id="grp_effects" value="EFECTE (IEȘIRI DECIZIONALE)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F3F1FD;strokeColor=#5B4FD6;fontColor=#5B4FD6;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="80" width="280" height="680" as="geometry" />
        </mxCell>

        <mxCell id="E1" value="E1: GRANTED_VIP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4EBF85;fontColor=#ffffff;strokeColor=#277b50;fontStyle=1;" vertex="1" parent="grp_effects">
          <mxGeometry x="20" y="40" width="240" height="45" as="geometry" />
        </mxCell>

        <mxCell id="E2" value="E2: DENIED_RESTRICTED_HOURS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e05d5d;fontColor=#ffffff;strokeColor=#b83232;fontStyle=1;" vertex="1" parent="grp_effects">
          <mxGeometry x="20" y="115" width="240" height="45" as="geometry" />
        </mxCell>

        <mxCell id="E3" value="E3: GRANTED_EV_CHARGING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4EBF85;fontColor=#ffffff;strokeColor=#277b50;fontStyle=1;" vertex="1" parent="grp_effects">
          <mxGeometry x="20" y="210" width="240" height="45" as="geometry" />
        </mxCell>

        <mxCell id="E4" value="E4: GRANTED_REGULAR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4EBF85;fontColor=#ffffff;strokeColor=#277b50;fontStyle=1;" vertex="1" parent="grp_effects">
          <mxGeometry x="20" y="340" width="240" height="45" as="geometry" />
        </mxCell>

        <mxCell id="E5" value="E5: GRANTED_PAID_OVERFLOW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2A63B;fontColor=#ffffff;strokeColor=#b36b10;fontStyle=1;" vertex="1" parent="grp_effects">
          <mxGeometry x="20" y="490" width="240" height="45" as="geometry" />
        </mxCell>

        <mxCell id="E6" value="E6: DENIED_QUOTA_EXCEEDED&#xa;(Efect implicit - altfel)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e05d5d;fontColor=#ffffff;strokeColor=#b83232;fontStyle=1;" vertex="1" parent="grp_effects">
          <mxGeometry x="20" y="600" width="240" height="50" as="geometry" />
        </mxCell>

        <!-- MUCHI (CONNECTORS) CU NOTATIE CURS -->
        <!-- Relație directă Implies: C1 -> E1 -->
        <mxCell id="edge_C1_E1" edge="1" source="C1" target="E1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#277b50;strokeWidth=2;" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- C3 -> NOT_C3 -->
        <mxCell id="edge_C3_NOT" edge="1" source="C3" target="OP_NOT_C3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#203752;strokeWidth=1.5;" parent="1" />

        <!-- C2 si NOT_C3 -> AND_C2 -> E2 -->
        <mxCell id="edge_C2_AND" edge="1" source="C2" target="OP_AND_C2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#203752;strokeWidth=1.5;" parent="1" />
        <mxCell id="edge_NOTC3_AND" edge="1" source="OP_NOT_C3" target="OP_AND_C2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#203752;strokeWidth=1.5;" parent="1" />
        <mxCell id="edge_ANDC2_E2" edge="1" source="OP_AND_C2" target="E2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b83232;strokeWidth=2;" parent="1" />

        <!-- C4, C5 -> AND_EV_BASE -->
        <mxCell id="edge_C4_AND" edge="1" source="C4" target="OP_AND_EV_BASE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#203752;strokeWidth=1.5;" parent="1" />
        <mxCell id="edge_C5_AND" edge="1" source="C5" target="OP_AND_EV_BASE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#203752;strokeWidth=1.5;" parent="1" />

        <!-- NOT_C3, C6 -> OR_EV_COND -->
        <mxCell id="edge_NOTC3_OREV" edge="1" source="OP_NOT_C3" target="OP_OR_EV_COND" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#203752;strokeWidth=1.5;" parent="1" />
        <mxCell id="edge_C6_OREV" edge="1" source="C6" target="OP_OR_EV_COND" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#203752;strokeWidth=1.5;" parent="1" />

        <!-- AND_EV_BASE si OR_EV_COND -> AND_EV_FINAL -> E3 -->
        <mxCell id="edge_ANDBASE_ANDFINAL" edge="1" source="OP_AND_EV_BASE" target="OP_AND_EV_FINAL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#203752;strokeWidth=1.5;" parent="1" />
        <mxCell id="edge_OREV_ANDFINAL" edge="1" source="OP_OR_EV_COND" target="OP_AND_EV_FINAL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#203752;strokeWidth=1.5;" parent="1" />
        <mxCell id="edge_ANDFINAL_E3" edge="1" source="OP_AND_EV_FINAL" target="E3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#277b50;strokeWidth=2;" parent="1" />

        <!-- Relație directă Implies: C6 -> E4 -->
        <mxCell id="edge_C6_E4" edge="1" source="C6" target="E4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#277b50;strokeWidth=2;" parent="1" />

        <!-- NOT_C3, C8 -> OR_OVF_COND -->
        <mxCell id="edge_NOTC3_OROVF" edge="1" source="OP_NOT_C3" target="OP_OR_OVF_COND" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#203752;strokeWidth=1.5;" parent="1" />
        <mxCell id="edge_C8_OROVF" edge="1" source="C8" target="OP_OR_OVF_COND" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#203752;strokeWidth=1.5;" parent="1" />

        <!-- C7 si OR_OVF_COND -> AND_OVF_FINAL -> E5 -->
        <mxCell id="edge_C7_ANDOVF" edge="1" source="C7" target="OP_AND_OVF_FINAL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#203752;strokeWidth=1.5;" parent="1" />
        <mxCell id="edge_OROVF_ANDOVF" edge="1" source="OP_OR_OVF_COND" target="OP_AND_OVF_FINAL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#203752;strokeWidth=1.5;" parent="1" />
        <mxCell id="edge_ANDOVF_E5" edge="1" source="OP_AND_OVF_FINAL" target="E5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b36b10;strokeWidth=2;" parent="1" />

        <!-- LEGENDA NOTATII CURS -->
        <mxCell id="grp_legend" value="LEGENDĂ NOTAȚII (CURS TSS / GLENFORD MYERS)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#203752;fontColor=#203752;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="80" width="380" height="95" as="geometry" />
        </mxCell>
        <mxCell id="leg_text" value="• —&gt;  Implies (dacă C atunci Ef)&#xa;• ~    Not-Implies (dacă ¬C atunci Ef)&#xa;• ^    And-Implies (dacă C1 ∧ C2 atunci Ef)&#xa;• v    Or-Implies (dacă C1 ∨ C2 atunci Ef)&#xa;• E    Exclusive (cel mult o cauză adevărată)&#xa;• M    Masks (ierarhie priorități E1 &gt; E2 &gt; E3 &gt; E4 &gt; E5 &gt; E6)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#203752;" vertex="1" parent="grp_legend">
          <mxGeometry x="10" y="25" width="360" height="65" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
